# AuthentiScan Environment Configuration Template

# Database Connection (Leave blank for SQLite or provide PostgreSQL URI for production)
DATABASE_URL=sqlite:///./deepfake_db.sqlite
# DATABASE_URL=postgresql://user:password@host:5432/authentiscan_db

# Server Security & CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://authentiscan-frontend.onrender.com
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Video Processing Limits
MAX_UPLOAD_SIZE_MB=500
MODEL_VERSION=v2.0-mobilenetv2-lstm

# Frontend Configuration
VITE_API_URL=http://localhost:8001
